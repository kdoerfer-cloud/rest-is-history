<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Publishes your listening history once a day, at 22:30.

  macOS will not let a background job read the Apple Podcasts database, so this opens
  scripts/sync-listened.command in Terminal, exactly as if you had double-clicked it.
  A Terminal window opens each night and can be closed.

  Install:
    chmod +x scripts/sync-listened.command
    cp scripts/com.rest-is-history.listened.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.rest-is-history.listened 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rest-is-history.listened.plist

  Remove:
    launchctl bootout gui/$(id -u)/com.rest-is-history.listened
-->
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.rest-is-history.listened</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>Terminal</string>
    <string>/Users/Karl/Projects/rest-is-history-repo/scripts/sync-listened.command</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>   <integer>22</integer>
    <key>Minute</key> <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>    <string>/Users/Karl/Projects/rest-is-history-repo/.claude/logs/launchd.log</string>
  <key>StandardErrorPath</key>  <string>/Users/Karl/Projects/rest-is-history-repo/.claude/logs/launchd.log</string>
</dict>
</plist>
